# Skopiuj do pliku .env (w głównym katalogu projektu) i uzupełnij.
# Plik .env NIE trafia do repozytorium.

# --- Teksty (tytuły, opisy, plan zdjęć) – Claude API: https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Zdjęcia – Google Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Dane sprzedawcy wstawiane do opisów
# Numer bez spacji – w opisie OLX pojawi się jako 6-6-6-0-7-9-1-8-1
SELLER_PHONE=
SELLER_NAME=

# Frazy z nazwami innych marek ("zamiennik ...") w bloku słów kluczowych OLX.
# true = dodawaj, false = pomijaj (na Allegro nigdy nie są dodawane).
OLX_COMPETITOR_KEYWORDS=true

# --- Bot Telegram: token od @BotFather
TELEGRAM_BOT_TOKEN=
# Twoje ID z Telegrama (bot poda je, gdy napiszesz do niego pierwszy raz). Kilka po przecinku.
TELEGRAM_ALLOWED_USER_IDS=

# --- Panel www (/admin)
ADMIN_PASSWORD=

# Gdzie zapisywać paczki ofert i ustawienia (limity OLX)
DATA_DIR=./data
